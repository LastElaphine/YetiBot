{
	"tasks": {
		"dev:web": "cd web && deno run -A npm:vite",
		"build:web": "cd web && deno run -A npm:vite build",
		"dev": "deno run --allow-all --watch main.ts",
		"deploy-dev-commands": "deno run --allow-all deploy-commands.ts",
		"lint": "deno run -A npm:@biomejs/biome check",
		"lint-fix": "deno run -A npm:@biomejs/biome check --write",
		"test": "deno test --no-check --allow-all tests/",
		"test:watch": "deno test --no-check --allow-all --watch tests/"
	},
	"imports": {
		"@biomejs/biome": "npm:@biomejs/biome@^2.2.4",
		"@std/assert": "jsr:@std/assert@1",
		"@std/log": "jsr:@std/log@0.224",
		"@std/path": "jsr:@std/path@1",
		"discord": "npm:discord.js@^14.22.1",
		"lowdb": "npm:lowdb@^7.0.1",
		"zod": "npm:zod@^3.24.1"
	}
}
